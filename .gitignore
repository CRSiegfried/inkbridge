__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
.DS_Store
uv.lock

# AI-assistant scratch config — tooling preferences of whoever happens to be
# working here, not project convention. Kept local so the repo stays neutral
# about how contributors work.
.claude/
CLAUDE.md

# Device credentials / local captures — never commit these
*.env
.env
notes/local/
captures/
device-backup-*/

# Dispatch-ledger instance data (which docs THIS operator sent) and pulled
# .mark responses — machine-specific, never public
inkbridge-ledger.json
responses/

# Personal Private Cloud deployment instance (secrets, real data, evidence,
# runtime volumes). The PUBLIC, reusable deploy recipe lives in deploy/ itself;
# deploy/local/ is this machine's filled-in instance and never gets committed.
deploy/local/

# examples: sources tracked, generated artifacts and logs not
examples/*.pdf
examples/*.png
examples/*.json
examples/*.log
